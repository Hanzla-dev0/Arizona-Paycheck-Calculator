---
const { kind, heading } = Astro.props;
---
<section class="card tax-tool" data-tax-tool={kind}><h2>{heading}</h2><p class="muted">Enter your figures to see an illustrative estimate. Results update as you type. This is a planning aid, not a filed tax calculation.</p><div class="grid2"><div class="field"><label for="tool-income">{kind === 'overtime' ? 'Hourly rate ($)' : kind === 'salary-hourly' ? 'Annual salary ($)' : kind === 'raise' ? 'Current annual salary ($)' : kind === 'bonus' ? 'Bonus amount ($)' : kind === '1099' ? 'Net self-employment income ($)' : kind === 'effective' ? 'Gross income ($)' : 'Annual income ($)'}</label><input id="tool-income" data-tool-income type="number" min="0" value={kind === 'overtime' ? '25' : kind === 'bonus' ? '5000' : '60000'}></div><div class="field"><label for="tool-other">{kind === 'overtime' ? 'Overtime hours' : kind === 'salary-hourly' ? 'Hours worked per week' : kind === 'raise' ? 'Raise percentage (%)' : kind === 'effective' ? 'Total estimated tax ($)' : 'Other income or adjustment ($)'}</label><input id="tool-other" data-tool-other type="number" min="0" value={kind === 'effective' ? '9000' : kind === 'overtime' ? '10' : kind === 'salary-hourly' ? '40' : kind === 'raise' ? '5' : '0'}></div><div class="field"><label for="tool-rate">{kind === 'overtime' ? 'Overtime multiplier' : kind === 'salary-hourly' ? 'Paid weeks per year' : kind === 'raise' ? 'Not used' : 'Estimated tax rate (%)'}</label><input id="tool-rate" data-tool-rate type="number" min="0" max="60" step="0.1" value={kind === 'overtime' ? '1.5' : kind === 'salary-hourly' ? '52' : kind === 'raise' ? '0' : '22'}></div><div class="field"><label for="tool-periods">Payments per year</label><select id="tool-periods" data-tool-periods><option value="4">4 (quarterly)</option><option value="12">12 (monthly)</option><option value="24">24 (twice monthly)</option><option value="26" selected>26 (biweekly)</option><option value="52">52 (weekly)</option></select></div></div><button class="btn" type="button" data-tool-calc>Calculate estimate</button><div class="tool-output" aria-live="polite"><p class="muted">Estimated result</p><strong data-tool-result>$0.00</strong><p data-tool-note class="muted">Enter your figures and calculate.</p></div></section>
<script>import { initTaxTools } from '../scripts/tax-tools.js'; initTaxTools();</script>
