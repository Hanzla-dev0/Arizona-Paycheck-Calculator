---
import { TAX } from '../config/tax.js';
const { mode = 'salary' } = Astro.props; // 'salary' or 'hourly'
const freqs = Object.entries(TAX.payFrequencies);
const a4 = TAX.arizona.a4Options;
---
<div class="calc" id="calc" data-default-mode={mode}>
  <form class="card" id="calc-form" novalidate aria-label="Paycheck calculator inputs">
    <h2>Your pay details</h2>
    <p id="calc-error" class="notice hidden" role="alert"></p>
    <div class="seg" role="radiogroup" aria-label="Pay type">
      <label><input type="radio" name="payType" value="salary" checked={mode === 'salary'} /><span>Salary</span></label>
      <label><input type="radio" name="payType" value="hourly" checked={mode === 'hourly'} /><span>Hourly</span></label>
    </div>

    <div class="grid2">
      <div class="field" data-show="salary">
        <label for="salary">Annual salary ($)</label>
        <input id="salary" name="salary" type="number" inputmode="decimal" min="0" step="any" value="60000" />
      </div>
      <div class="field" data-show="hourly">
        <label for="hourlyRate">Hourly rate ($)</label>
        <input id="hourlyRate" name="hourlyRate" type="number" inputmode="decimal" min="0" step="any" value="22" />
      </div>
      <div class="field" data-show="hourly">
        <label for="hoursPerWeek">Hours per week</label>
        <input id="hoursPerWeek" name="hoursPerWeek" type="number" inputmode="decimal" min="0" max="168" step="any" value="40" />
      </div>
      <div class="field" data-show="hourly">
        <label for="overtimeHours">Overtime hours per week</label>
        <input id="overtimeHours" name="overtimeHours" type="number" inputmode="decimal" min="0" max="100" step="any" value="0" />
        <p class="hint">Paid at 1.5 times your rate.</p>
      </div>
      <div class="field">
        <label for="annualTips">Tips ($ per year, optional)</label>
        <input id="annualTips" name="annualTips" type="number" inputmode="decimal" min="0" step="any" value="0" />
        <p class="hint">Treated as regular wages, spread evenly.</p>
      </div>
      <div class="field">
        <label for="frequency">Pay frequency</label>
        <select id="frequency" name="frequency">
          {freqs.map(([k, v]) => <option value={k} selected={k === 'biweekly'}>{v.label}</option>)}
        </select>
      </div>
      <div class="field">
        <label for="filingStatus">Federal filing status (Form W-4)</label>
        <select id="filingStatus" name="filingStatus">
          <option value="single">Single or married filing separately</option>
          <option value="married">Married filing jointly</option>
          <option value="hoh">Head of household</option>
        </select>
      </div>
      <div class="field">
        <label for="k401Percent">401(k) / 403(b) contribution (% of pay)</label>
        <input id="k401Percent" name="k401Percent" type="number" inputmode="decimal" min="0" max="100" step="any" value="0" />
      </div>
      <div class="field">
        <label for="section125PerPeriod">Pre-tax health, dental, HSA ($ per paycheck)</label>
        <input id="section125PerPeriod" name="section125PerPeriod" type="number" inputmode="decimal" min="0" step="any" value="0" />
      </div>
      <div class="field">
        <label for="postTaxPerPeriod">Other after-tax deductions ($ per paycheck)</label>
        <input id="postTaxPerPeriod" name="postTaxPerPeriod" type="number" inputmode="decimal" min="0" step="any" value="0" />
      </div>
    </div>

    <details class="more">
      <summary>Advanced withholding options</summary>
      <div class="grid2">
        <div class="field">
          <label for="a4Rate">Arizona Form A-4 withholding rate</label>
          <select id="a4Rate" name="a4Rate">
            {a4.map((r) => <option value={r} selected={r === TAX.arizona.defaultA4}>{(r * 100).toFixed(1)}%{r === TAX.arizona.defaultA4 ? ' (default)' : ''}</option>)}
          </select>
          <p class="hint">Default is 2.0% if you never filed an A-4.</p>
        </div>
        <div class="field">
          <label for="extraAzPerPeriod">Extra Arizona withholding ($ per paycheck)</label>
          <input id="extraAzPerPeriod" name="extraAzPerPeriod" type="number" inputmode="decimal" min="0" step="any" value="0" />
        </div>
        <div class="field">
          <label class="check"><input type="checkbox" name="step2" id="step2" /> W-4 Step 2 box is checked (multiple jobs)</label>
        </div>
        <div class="field">
          <label class="check"><input type="checkbox" name="w4Exempt" id="w4Exempt" /> I claim exempt from federal withholding</label>
        </div>
        <div class="field">
          <label class="check"><input type="checkbox" name="azExempt" id="azExempt" /> I elected 0% on Arizona Form A-4</label>
        </div>
        <div class="field">
          <label for="ytdSocialSecurityWages">Year-to-date Social Security wages ($)</label>
          <input id="ytdSocialSecurityWages" name="ytdSocialSecurityWages" type="number" inputmode="decimal" min="0" step="any" placeholder="Leave blank" />
          <p class="hint">Only for high earners. Wages paid so far this year by this employer.</p>
        </div>
        <div class="field">
          <label for="ytdMedicareWages">Year-to-date Medicare wages ($)</label>
          <input id="ytdMedicareWages" name="ytdMedicareWages" type="number" inputmode="decimal" min="0" step="any" placeholder="Leave blank" />
        </div>
        <div class="field">
          <label for="credits">W-4 Step 3: credits ($ per year)</label>
          <input id="credits" name="credits" type="number" inputmode="decimal" min="0" step="any" value="0" />
        </div>
        <div class="field">
          <label for="step4a">W-4 Step 4(a): other income ($ per year)</label>
          <input id="step4a" name="step4a" type="number" inputmode="decimal" min="0" step="any" value="0" />
        </div>
        <div class="field">
          <label for="step4b">W-4 Step 4(b): deductions ($ per year)</label>
          <p class="hint">Use the total from the official W-4 Deductions Worksheet. It can include qualified tips, qualified overtime, car-loan interest and senior deductions. This calculator does not check whether you qualify.</p>
          <input id="step4b" name="step4b" type="number" inputmode="decimal" min="0" step="any" value="0" />
        </div>
        <div class="field">
          <label for="extraFedPerPeriod">W-4 Step 4(c): extra federal ($ per paycheck)</label>
          <input id="extraFedPerPeriod" name="extraFedPerPeriod" type="number" inputmode="decimal" min="0" step="any" value="0" />
        </div>
      </div>
    </details>
    <p><button class="btn ghost" type="reset" id="reset">Reset</button> <button class="btn ghost" type="button" id="print-results">Print result</button></p>
    <p class="muted">Results update as you type. Nothing you enter is sent anywhere or stored.</p>
  </form>

  <section class="card results" aria-labelledby="res-h">
    <h2 id="res-h">Your estimated take-home pay</h2>
    <p class="muted" id="res-sub">Per <span data-out="freqLabel"></span> paycheck · {TAX.year} tax year</p>
    <div class="big" data-out="net" aria-live="polite" aria-atomic="true">$0.00</div>
    <p class="muted">Effective tax rate: <strong data-out="effRate">0.0%</strong></p>

    <div class="bar" role="img" aria-label="Share of gross pay going to each item">
      <i data-bar="net" style="background:#1f6b45"></i>
      <i data-bar="federal" style="background:#12263f"></i>
      <i data-bar="arizona" style="background:#b84a22"></i>
      <i data-bar="fica" style="background:#7a8aa0"></i>
      <i data-bar="other" style="background:#d6b25e"></i>
    </div>
    <div class="legend" aria-hidden="true">
      <span><b style="background:#1f6b45"></b>Take-home</span><span><b style="background:#12263f"></b>Federal</span>
      <span><b style="background:#b84a22"></b>Arizona</span><span><b style="background:#7a8aa0"></b>Soc. Sec. + Medicare</span>
      <span><b style="background:#d6b25e"></b>Other deductions</span>
    </div>

    <h3>Paycheck breakdown</h3>
    <table>
      <caption class="vh">Paycheck breakdown per pay period</caption>
      <tbody>
        <tr><th scope="row">Gross pay</th><td class="r" data-out="gross"></td></tr>
        <tr><th scope="row">Federal income tax</th><td class="r" data-out="federal"></td></tr>
        <tr><th scope="row">Arizona income tax</th><td class="r" data-out="arizona"></td></tr>
        <tr><th scope="row">Social Security</th><td class="r" data-out="socialSecurity"></td></tr>
        <tr><th scope="row">Medicare</th><td class="r" data-out="medicare"></td></tr>
        <tr data-row="additionalMedicare" class="hidden"><th scope="row">Additional Medicare (0.9%)</th><td class="r" data-out="additionalMedicare"></td></tr>
        <tr><th scope="row">401(k) / 403(b)</th><td class="r" data-out="k401"></td></tr>
        <tr><th scope="row">Pre-tax health / HSA</th><td class="r" data-out="section125"></td></tr>
        <tr><th scope="row">Other after-tax deductions</th><td class="r" data-out="postTax"></td></tr>
        <tr class="total"><th scope="row">Total deductions</th><td class="r" data-out="totalDeductions"></td></tr>
        <tr class="total"><th scope="row">Net take-home pay</th><td class="r" data-out="net2"></td></tr>
      </tbody>
    </table>

    <h3>Take-home pay by period</h3>
    <table>
      <caption class="vh">Estimated take-home pay by pay period</caption>
      <tbody>
        <tr><th scope="row">Weekly</th><td class="r" data-out="th-weekly"></td></tr>
        <tr><th scope="row">Every two weeks</th><td class="r" data-out="th-biweekly"></td></tr>
        <tr><th scope="row">Twice a month</th><td class="r" data-out="th-semimonthly"></td></tr>
        <tr><th scope="row">Monthly</th><td class="r" data-out="th-monthly"></td></tr>
        <tr><th scope="row">Annual</th><td class="r" data-out="th-annual"></td></tr>
      </tbody>
    </table>

    <div id="a4-note" class="notice hidden" role="status"></div>
    <p class="muted">Estimate only. See <a href="/methodology/">how this is calculated</a>.</p>
  </section>
</div>

<script>
  import { initCalculator } from '../scripts/calculator.js';
  initCalculator();
</script>
