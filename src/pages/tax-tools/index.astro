---
import BaseLayout from '../../layouts/BaseLayout.astro';
const tools = [{"slug": "effective-tax-rate-calculator", "title": "Effective Tax Rate Calculator", "desc": "Estimate your effective tax rate by comparing total estimated taxes with gross income."}, {"slug": "overtime-tax-calculator", "title": "Overtime Pay Calculator", "desc": "Estimate gross overtime pay using your hourly rate and overtime hours."}, {"slug": "bonus-tax-calculator", "title": "Bonus Tax Calculator", "desc": "Estimate withholding on a one-time bonus using an assumed supplemental withholding rate."}, {"slug": "1099-tax-calculator", "title": "1099 Tax Calculator", "desc": "Build a simplified reserve estimate for independent contractor income."}, {"slug": "quarterly-estimated-tax-calculator", "title": "Quarterly Estimated Tax Calculator", "desc": "Estimate a quarterly tax reserve from income and an assumed effective tax rate."}, {"slug": "tax-withholding-calculator", "title": "Tax Withholding Calculator", "desc": "Estimate a per-paycheck withholding amount using an effective tax rate."}, {"slug": "salary-to-hourly-calculator", "title": "Salary to Hourly Calculator", "desc": "Convert annual salary into an estimated hourly equivalent."}, {"slug": "pay-raise-calculator", "title": "Pay Raise Calculator", "desc": "Estimate your new salary and the increase from a raise percentage."}, {"slug": "paycheck-frequency-calculator", "title": "Paycheck Frequency Calculator", "desc": "Estimate gross and after-withholding pay for weekly, biweekly or monthly schedules."}];
---
<BaseLayout title="Tax Calculators & Tools | Paycheck Planning" description="Explore free tax planning tools for effective tax rate, overtime, bonuses, 1099 income, quarterly estimated payments and paycheck withholding." path="/tax-tools/" crumbs={[{name:'Tax Tools',href:'/tax-tools/'}]}>
<section class="hero"><p class="eyebrow">TAX PLANNING RESOURCES</p><h1>Tax Calculators & Tools</h1><p class="lead">Explore practical estimators for common pay and tax questions, from overtime and bonuses to contractor income and withholding.</p></section>
<div class="tool-grid">{tools.map(t=><a class="tool-card" href={`/tax-tools/${t.slug}/`}><span class="tool-icon">↗</span><h2>{t.title}</h2><p>{t.desc}</p><b>Open calculator →</b></a>)}</div>
<section class="prose"><h2>Use estimates as a starting point</h2><p>Tax outcomes depend on filing status, deductions, credits, income sources, state and local rules, and timing. These tools help with basic planning but do not replace official forms, payroll systems or professional advice.</p><p>For state-specific take-home pay, browse <a href="/paycheck-calculators-by-state/">paycheck calculators by state</a>. For Arizona withholding details, visit the <a href="/">Arizona Paycheck Calculator</a>.</p></section>
</BaseLayout>
