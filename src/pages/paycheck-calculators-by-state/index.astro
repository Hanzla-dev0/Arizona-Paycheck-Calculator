---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { STATES } from '../../data/states.js';
const schema={'@context':'https://schema.org','@type':'CollectionPage','name':'Paycheck Calculators by State','description':'Browse paycheck calculators for all 50 states and the District of Columbia.'};
---
<BaseLayout title="Paycheck Calculators by State | 50 States + DC" description="Choose a state to estimate take-home pay, federal taxes, FICA and state or local withholding. Browse all 50 states and Washington, DC." path="/paycheck-calculators-by-state/" schema={[schema]} crumbs={[{name:'Paycheck Calculators by State',href:'/paycheck-calculators-by-state/'}]}>
<section class="hero"><p class="eyebrow">UNITED STATES PAYCHECK TOOLS</p><h1>Paycheck Calculators by State</h1><p class="lead">Choose where you work to estimate your paycheck. Each state page explains the main payroll tax considerations and includes an editable take-home pay estimator.</p><div class="hero-meta"><span>50 states</span><span>District of Columbia</span><span>Free estimates</span></div></section>
<div class="state-directory"><label for="state-search">Find your state</label><input id="state-search" type="search" placeholder="Search a state..." aria-label="Search states"><div class="state-grid" id="state-grid">{STATES.map(s=><a class="state-link" data-state-name={s.name.toLowerCase()} href={`/${s.slug}-paycheck-calculator/`}><span>{s.name}</span><small>{s.code}</small></a>)}</div><p id="no-states" class="muted" hidden>No matching state found.</p></div>
<section class="prose"><h2>How to use these state paycheck calculators</h2><p>Select the state where you perform your work, enter gross salary or hourly pay, choose a pay schedule and federal filing status, and add any deductions. State and local withholding fields are editable because tax treatment and payroll withholding methods vary by jurisdiction.</p><p>These pages are designed for planning and comparison. They are not official state tax calculators and should not replace an employer pay statement, state withholding worksheet or tax professional's advice.</p><h2>Related tools</h2><p>Visit the <a href="/tax-tools/">tax tools directory</a> for overtime, bonus, effective tax rate, contractor and estimated tax calculators.</p></section>
</BaseLayout>
<script>const input=document.querySelector('#state-search');const links=[...document.querySelectorAll('.state-link')];input?.addEventListener('input',()=>{const q=input.value.trim().toLowerCase();let count=0;links.forEach(a=>{const show=a.dataset.stateName.includes(q);a.hidden=!show;if(show)count++;});document.querySelector('#no-states').hidden=count>0;});</script>
