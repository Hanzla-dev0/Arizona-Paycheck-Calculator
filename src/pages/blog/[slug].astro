---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Astro requires getStaticPaths to use its own local data; frontmatter
// variables outside the function are not available inside this function.
export async function getStaticPaths() {
  const posts = import.meta.glob('../../content/blog/*.md');
  return Promise.all(
    Object.entries(posts).map(async ([file, load]) => {
      const mod = await load();
      const slug = file.split('/').pop().replace(/\.md$/, '');
      return {
        params: { slug },
        props: {
          Content: mod.default,
          title: mod.frontmatter?.title ?? slug,
          description: mod.frontmatter?.description ?? 'A practical paycheck and tax guide.',
        },
      };
    }),
  );
}

const { slug } = Astro.params;
const { Content, title, description } = Astro.props;
---
<BaseLayout title={`${title} | Arizona Paycheck Calculator`} description={description} path={`/blog/${slug}/`} crumbs={[{ name: 'Blog', href: '/blog/' }, { name: title, href: `/blog/${slug}/` }]}>
  <article class="prose article">
    <p class="eyebrow">PAYCHECK &amp; TAX EDUCATION</p>
    <h1>{title}</h1>
    <Content />
    <p class="article-back"><a href="/blog/">← Back to all articles</a></p>
  </article>
</BaseLayout>
