---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site.js';
---
<BaseLayout title="Privacy Policy – Arizona Paycheck Calculator" description="Privacy policy for Arizona Paycheck Calculator." path="/privacy/" crumbs={[{ name: 'Privacy Policy', href: '/privacy/' }]}>
  <article class="content">
    <h1>Privacy Policy</h1>
    <h2>What you enter</h2>
    <p>The calculator runs in your browser. The pay figures you type are not sent to our servers and are not stored.</p>
    <h2>Cookies and tracking</h2>
    <p>This site does not currently use analytics or advertising cookies. If that changes, this policy will be updated before it happens.</p>
    <h2>Hosting logs</h2>
    <p>Our hosting provider may keep standard server logs, such as IP address and pages requested, for security and reliability.</p>
    <h2>Contact</h2>
    <p>Questions about privacy can be sent through the <a href="/contact/">contact page</a>.</p>
  </article>
</BaseLayout>
