---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../config/site.js';
---
<BaseLayout title="Contact – Arizona Paycheck Calculator" description="How to contact Arizona Paycheck Calculator about errors or suggestions." path="/contact/" crumbs={[{ name: 'Contact', href: '/contact/' }]}>
  <article class="content">
    <h1>Contact</h1>
    {SITE.contactEmail ? (
      <p>Found a mistake or have a suggestion? Email <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.</p>
    ) : (
      <p>A contact email has not been added yet. Please check back soon.</p>
    )}
    <p>We cannot give personal tax advice. For questions about your own withholding, contact your employer or the Arizona Department of Revenue.</p>
  </article>
</BaseLayout>
