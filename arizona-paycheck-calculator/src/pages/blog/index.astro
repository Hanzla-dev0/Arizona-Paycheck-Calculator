---
import BaseLayout from '../../layouts/BaseLayout.astro';
const modules = import.meta.glob('../../content/blog/*.md', { eager: true });
const posts = Object.entries(modules)
  .map(([file, m]) => ({ slug: file.split('/').pop().replace(/\.md$/, ''), ...m.frontmatter }))
  .sort((a, b) => new Date(b.date) - new Date(a.date));
---
<BaseLayout
  title="Arizona Paycheck Blog – Guides and Tips"
  description="Plain-English articles about Arizona paychecks, withholding, deductions and take-home pay."
  path="/blog/"
  crumbs={[{ name: 'Blog', href: '/blog/' }]}
>
  <section class="hero"><h1>Arizona Paycheck Blog</h1><p class="lead">Guides and tips on paychecks, withholding and take-home pay.</p></section>
  <ul class="related">
    {posts.map((p) => (
      <li><a href={`/blog/${p.slug}/`}><strong>{p.title}</strong><span>{p.description}</span></a></li>
    ))}
  </ul>
</BaseLayout>
