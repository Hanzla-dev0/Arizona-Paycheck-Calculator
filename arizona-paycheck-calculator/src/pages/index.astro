---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import Faq from '../components/Faq.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE } from '../config/site.js';
import { TAX } from '../config/tax.js';

const faqs = [
  { q: 'How does the Arizona paycheck calculator work?', a: 'It takes your gross pay, subtracts pre-tax deductions, then estimates federal income tax withholding (IRS Publication 15-T percentage method), Arizona withholding (your Form A-4 percentage), Social Security and Medicare. What is left is your estimated take-home pay.' },
  { q: 'How much Arizona income tax is taken out of my paycheck?', a: 'Your employer withholds the percentage you chose on Arizona Form A-4 from your gross taxable wages. If you never filed an A-4, the default is 2.0%. You can pick 0.5%, 1.0%, 1.5%, 2.0%, 2.5%, 3.0% or 3.5%.' },
  { q: 'Is the withholding the same as the Arizona tax I owe?', a: 'No. Arizona tax owed at filing time is a flat 2.5% of taxable income after deductions. Withholding is only a prepayment, so you may get a refund or owe a balance when you file.' },
  { q: 'Does Arizona have local or city income tax?', a: 'No. Arizona cities do not charge a local income tax on wages, so this calculator only includes federal tax, Arizona state withholding, Social Security and Medicare.' },
  { q: 'Why is my real paycheck different from the estimate?', a: 'Common reasons are bonuses, benefit plans not entered here, wage garnishments, different W-4 or A-4 choices, or your employer rounding differently. Treat the result as an estimate and check your pay stub.' },
];
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: SITE.name,
  url: SITE.url + '/',
  applicationCategory: 'FinanceApplication',
  operatingSystem: 'Any',
  description: SITE.description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<BaseLayout
  title="Arizona Paycheck Calculator – Take-Home Pay After Tax"
  description="Free Arizona paycheck calculator. Estimate take-home pay for salary or hourly work after federal tax, Arizona withholding, Social Security and Medicare."
  path="/"
  schema={[appSchema]}
>
  <section class="hero">
    <h1>Arizona Paycheck Calculator</h1>
    <p class="lead">Find your estimated take-home pay in Arizona. Enter your salary or hourly wage and see federal tax, Arizona withholding, Social Security and Medicare taken out of each paycheck.</p>
    <span class="badge">{TAX.year} tax year</span>
  </section>

  <Calculator mode="salary" />
  <AdSlot />

  <div class="content">
    <h2>What comes out of an Arizona paycheck</h2>
    <ul>
      <li><strong>Federal income tax:</strong> based on your Form W-4, filing status and pay.</li>
      <li><strong>Arizona income tax:</strong> the percentage on your <a href="/guides/arizona-form-a-4-withholding/">Form A-4</a> (default 2.0%).</li>
      <li><strong>Social Security:</strong> 6.2% of wages up to ${TAX.fica.socialSecurityWageBase.toLocaleString('en-US')} in {TAX.year}.</li>
      <li><strong>Medicare:</strong> 1.45% of all wages, plus 0.9% on wages above $200,000.</li>
      <li><strong>Optional deductions:</strong> retirement, health insurance and other items you choose. See the <a href="/guides/arizona-paycheck-deductions/">deductions guide</a>.</li>
    </ul>
    <p>Arizona has no city income tax and no state disability insurance payroll tax, so the list above covers the main taxes on a typical check.</p>

    <h2>How to use the calculator</h2>
    <ol>
      <li>Choose <em>Salary</em> or <em>Hourly</em> and enter your pay.</li>
      <li>Pick how often you are paid and your W-4 filing status.</li>
      <li>Add retirement or insurance deductions if you have them.</li>
      <li>Open <em>Advanced withholding options</em> to match your W-4 and A-4 choices.</li>
    </ol>
    <p>Prefer a focused version? Try the <a href="/arizona-hourly-paycheck-calculator/">hourly paycheck calculator</a> with overtime, or see <a href="/arizona-salary-after-tax/">what a salary is worth after tax</a>.</p>
  </div>

  <Faq items={faqs} />
  <RelatedLinks items={[
    { href: '/arizona-hourly-paycheck-calculator/', title: 'Hourly Paycheck Calculator', text: 'Hourly wage with overtime.' },
    { href: '/arizona-salary-after-tax/', title: 'Salary After Tax', text: 'Annual, monthly and biweekly take-home.' },
    { href: '/guides/arizona-form-a-4-withholding/', title: 'Form A-4 Guide', text: 'Choose your Arizona withholding rate.' },
    { href: '/methodology/', title: 'Methodology', text: 'Formulas, assumptions and sources.' },
  ]} />
</BaseLayout>
