---
import BaseLayout from '../../layouts/BaseLayout.astro';
import RelatedLinks from '../../components/RelatedLinks.astro';
import { SITE } from '../../config/site.js';
import { TAX } from '../../config/tax.js';
const path = '/guides/arizona-paycheck-deductions/';
const article = {
  '@context': 'https://schema.org', '@type': 'Article',
  headline: 'Arizona Paycheck Deductions Explained',
  mainEntityOfPage: SITE.url + path,
  dateModified: SITE.taxDataReviewed,
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
};
---
<BaseLayout
  title="Arizona Paycheck Deductions Explained"
  description="A plain-English guide to taxes and deductions on an Arizona paycheck: federal tax, Arizona withholding, Social Security, Medicare and pre-tax benefits."
  path={path} type="article" schema={[article]}
  crumbs={[{ name: 'Paycheck Deductions', href: path }]}
>
  <article class="content">
    <h1>Arizona Paycheck Deductions Explained</h1>
    <p class="muted">Last reviewed {SITE.taxDataReviewed} · {TAX.year} tax year</p>
    <p>Your gross pay is what you earn. Your net pay is what reaches your bank account. The difference is taxes plus any deductions you chose.</p>

    <h2>Taxes</h2>
    <h3>Federal income tax</h3>
    <p>Set by your Form W-4 and your pay. Higher pay and a single filing status mean more tax withheld.</p>
    <h3>Arizona income tax</h3>
    <p>A percentage of gross taxable wages chosen on <a href="/guides/arizona-form-a-4-withholding/">Form A-4</a>. The default is {(TAX.arizona.defaultA4 * 100).toFixed(1)}%.</p>
    <h3>Social Security and Medicare (FICA)</h3>
    <p>Social Security is {(TAX.fica.socialSecurityRate * 100).toFixed(1)}% of wages up to ${TAX.fica.socialSecurityWageBase.toLocaleString('en-US')} in {TAX.year}. Medicare is {(TAX.fica.medicareRate * 100).toFixed(2)}% of all wages, with an extra {(TAX.fica.additionalMedicareRate * 100).toFixed(1)}% on wages above ${TAX.fica.additionalMedicareThreshold.toLocaleString('en-US')}.</p>

    <h2>Pre-tax deductions</h2>
    <p>These lower the wages used for income tax.</p>
    <ul>
      <li><strong>Traditional 401(k) or 403(b):</strong> reduces income tax wages but not Social Security or Medicare wages.</li>
      <li><strong>Health, dental and vision premiums, HSA and FSA through your employer:</strong> usually reduce income tax and FICA wages.</li>
    </ul>

    <h2>After-tax deductions</h2>
    <p>Roth 401(k) contributions, union dues, some insurance and wage garnishments come out after taxes are figured and do not lower your taxable wages.</p>

    <h2>What Arizona does not take</h2>
    <p>Arizona has no local income tax and no state disability insurance payroll tax, so those lines will not appear on a typical Arizona pay stub.</p>
    <p>General information only, not tax advice.</p>
  </article>
  <RelatedLinks items={[
    { href: '/', title: 'Arizona Paycheck Calculator', text: 'Enter your own deductions.' },
    { href: '/arizona-salary-after-tax/', title: 'Salary After Tax', text: 'Take-home for common salaries.' },
    { href: '/methodology/', title: 'Methodology', text: 'Formulas and sources.' },
  ]} />
</BaseLayout>
