---
import BaseLayout from '../layouts/BaseLayout.astro';
import Calculator from '../components/Calculator.astro';
import Faq from '../components/Faq.astro';
import RelatedLinks from '../components/RelatedLinks.astro';
import AdSlot from '../components/AdSlot.astro';
import { SITE } from '../config/site.js';
import { TAX } from '../config/tax.js';

const faqs = [
  { q: 'How is hourly pay turned into a yearly amount?', a: 'The calculator multiplies your hourly rate by regular hours, adds overtime hours at 1.5 times your rate, and multiplies the weekly total by 52 weeks.' },
  { q: 'Does the calculator handle overtime?', a: 'Yes. Enter overtime hours per week and they are paid at time and a half. Real overtime rules depend on your job and employer, so check your pay stub.' },
  { q: 'Is the Arizona minimum wage used here?', a: 'No. You enter your own hourly rate. The calculator does not set or check minimum wage.' },
  { q: 'Why does my paycheck change when I work more hours?', a: 'Withholding is based on your pay for the period. Higher pay can move part of your income into a higher federal bracket, so take-home pay rises by less than gross pay.' },
];
const appSchema = {
  '@context': 'https://schema.org', '@type': 'WebApplication',
  name: 'Arizona Hourly Paycheck Calculator', url: SITE.url + '/arizona-hourly-paycheck-calculator/',
  applicationCategory: 'FinanceApplication', operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---
<BaseLayout
  title="Arizona Hourly Paycheck Calculator – Net Pay with Overtime"
  description="Calculate Arizona take-home pay from your hourly wage. Includes overtime, federal tax, Arizona withholding, Social Security and Medicare."
  path="/arizona-hourly-paycheck-calculator/"
  crumbs={[{ name: 'Hourly Paycheck Calculator', href: '/arizona-hourly-paycheck-calculator/' }]}
  schema={[appSchema]}
>
  <section class="hero">
    <h1>Arizona Hourly Paycheck Calculator</h1>
    <p class="lead">Enter your hourly rate, weekly hours and overtime to see your estimated net pay in Arizona. For a salary, use the <a href="/">main Arizona paycheck calculator</a>.</p>
    <span class="badge">{TAX.year} tax year</span>
  </section>
  <Calculator mode="hourly" />
  <AdSlot />
  <div class="content">
    <h2>Hourly pay: what to know</h2>
    <p>Hourly workers often see a different take-home amount each period because hours change. Taxes are estimated by treating your pay for the period as if it repeated all year, which is how most payroll systems withhold.</p>
    <h3>Example</h3>
    <p>A worker paid $22 an hour for 40 hours a week earns $880 a week, or $45,760 a year before any deductions. Enter those numbers above to see the federal, Arizona, Social Security and Medicare amounts.</p>
    <h3>Tips</h3>
    <ul>
      <li>Use your average weekly hours if they vary.</li>
      <li>Add unpaid breaks only if your employer does not count them as paid time.</li>
      <li>Tips and bonuses are not included. Add them to your hourly rate as an average if you want a rough figure.</li>
    </ul>
  </div>
  <Faq items={faqs} />
  <RelatedLinks items={[
    { href: '/', title: 'Arizona Paycheck Calculator', text: 'Main calculator for salary or hourly pay.' },
    { href: '/guides/arizona-paycheck-deductions/', title: 'Paycheck Deductions Guide', text: 'What is taken out and why.' },
    { href: '/guides/arizona-form-a-4-withholding/', title: 'Form A-4 Guide', text: 'Set your Arizona withholding rate.' },
  ]} />
</BaseLayout>
